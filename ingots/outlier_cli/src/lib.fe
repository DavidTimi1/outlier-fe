#![cfg(target_family = "unix")]
// Native Fe CLI, Replay Verifier, and Value-Iteration Solver (`ingots/outlier_cli`).
//
// Compiles to a standalone native executable (`fe build -i outlier_cli --backend native --emit executable`)
// sharing the exact same `outlier_core` state machine as the EVM contract (`OutlierTable`).
//
// Granular effect discipline (`docs/ARCHITECTURE.md §2, §5`):
// - `cmd_explain`, `cmd_vectors`, `cmd_analyze`: `uses (out: mut Stdout)` (zero filesystem access)
// - `cmd_play`: `uses (args: Args, out: mut Stdout, fs: mut Fs)`
// - `cmd_replay`: `uses (args: Args, out: mut Stdout, err: mut Stderr, fs: Fs)` (READ-ONLY `Fs`!)

use core::MemBuffer
pub use hex::{parse_u256_slice, push_dec, push_hex_short, push_hex_u256}
pub use log_v1::{
    play_and_log,
    play_and_log_with_opts,
    verify_log_buffer,
    write_log_header,
    write_log_step,
}
use outlier_core::{
    COMMIT_WINDOW,
    Colour,
    DOMAIN_TAG,
    FINISH,
    GameState,
    Input,
    JOIN_WINDOW,
    MOVE_WINDOW,
    PUSH,
    REVEAL_WINDOW,
    ROUND_CAP,
    Seat,
    StepCtx,
    commitment,
    step,
}
pub use solver::run_analysis_report
use std::env::Args
use std::fs::Fs
use std::io::{Display, Stderr, Stdout, eprint_buffer, print_buffer}
use std::native::Host
use std::process::Exit
use testkit::rolling_parity_range

fn cmd_explain() uses (out: mut Stdout) {
    var buf = MemBuffer::empty()
    "==============================================================================\n".fmt(mut buf)
    "    ___    _   _   _____   _       ___   _____   ____  \n".fmt(mut buf)
    "   / _ \\  | | | | |_   _| | |     |_ _| | ____| |  _ \\ \n".fmt(mut buf)
    "  | | | | | | | |   | |   | |      | |  |  _|   | |_) |\n".fmt(mut buf)
    "  | |_| | | |_| |   | |   | |___   | |  | |___  |  _ < \n".fmt(mut buf)
    "   \\___/   \\___/    |_|   |_____| |___| |_____| |_| \\_\\\n\n".fmt(mut buf)
    "   THREE-PLAYER HIDDEN-MOVE PROTOCOL  //  ONE PURE FE STATE MACHINE\n".fmt(mut buf)
    "   Same `outlier_core::step` compiles to:  [EVM Contract]  +  [Native CLI]\n".fmt(mut buf)
    "==============================================================================\n\n".fmt(mut buf)
    "  (1) SEALED KECCAK COMMIT         (2) ODD-ONE-OUT REVEAL          (3) WINNER MOVE\n".fmt(mut buf)
    "  +------------------------+       +-------------------------+     +---------------+\n".fmt(mut buf)
    "  | S0: [SEALED 0x2e..98]  |       | S0: [ RED   ] --+       |     |   +1 ===>     |\n".fmt(mut buf)
    "  |                        |       |                 +- MATCH|     |   ADVANCE     |\n".fmt(mut buf)
    "  | S1: [SEALED 0x8a..c2]  | ====> | S1: [ RED   ] --+       |     |      or       |\n".fmt(mut buf)
    "  |                        |       |                         |     |   -1 <===     |\n".fmt(mut buf)
    "  | S2: [SEALED 0x1b..a3]  |       | S2: < BLUE  > * OUTLIER!| ==> |   PUSH(opp)   |\n".fmt(mut buf)
    "  +------------------------+       +-------------------------+     +---------------+\n".fmt(mut buf)
    "   7-word Keccak-256 lockbox        keccak(colour,nonce) check      Race 0 ---> 4*\n\n".fmt(mut buf)
    "  (4) ANTI-KINGMAKING FORFEIT: `settle_forfeit(mask, stake) -> [u256; 3]`\n".fmt(mut buf)
    "      Stallers forfeit stake; survivors split ceil/floor(STAKE/2) independently\n".fmt(mut buf)
    "      of board positions (board `Positions` omitted from the type signature!).\n\n".fmt(mut buf)
    "------------------------------------------------------------------------------\n".fmt(mut buf)
    "  Parameters  : FINISH=".fmt(mut buf)
    push_dec(mut buf, FINISH as u256)
    "  |  PUSH=".fmt(mut buf)
    push_dec(mut buf, PUSH as u256)
    "  |  ROUND_CAP=".fmt(mut buf)
    push_dec(mut buf, ROUND_CAP as u256)
    "\n  Windows (s) : JOIN=".fmt(mut buf)
    push_dec(mut buf, JOIN_WINDOW)
    " |  COMMIT=".fmt(mut buf)
    push_dec(mut buf, COMMIT_WINDOW)
    " |  REVEAL=".fmt(mut buf)
    push_dec(mut buf, REVEAL_WINDOW)
    " |  MOVE=".fmt(mut buf)
    push_dec(mut buf, MOVE_WINDOW)
    "\n  DOMAIN_TAG  : ".fmt(mut buf)
    push_hex_u256(mut buf, DOMAIN_TAG)
    "\n==============================================================================\n".fmt(mut buf)
    print_buffer(buf)
}

fn cmd_vectors() uses (out: mut Stdout) {
    var buf = MemBuffer::empty()
    "=== OUTLIER Foundry `cast` Cryptographic Vector Self-Check ===\n".fmt(mut buf)

    let nonce0: u256 = 0xdeadbeefcafebabe0123456789abcdef0123456789abcdefdeadbeefcafebabe
    let exp0: u256 = 0x2e36c50cb20de8ab24b2220e3f043bdd6aa0db9ff6943d6b436cdbf29135e398
    let got0 = commitment(
        table: 0x1234,
        game_id: 1,
        round: 1,
        seat: Seat::s0(),
        colour: Colour::Green,
        nonce: nonce0,
    )
    assert!(got0 == exp0)
    "  [OK] COMMIT_VEC_0 = ".fmt(mut buf)
    push_hex_u256(mut buf, got0)
    "\n".fmt(mut buf)

    let exp1: u256 = 0x1b4d0fe1757c61e3bebb8d4106b682eff562b2a2bd3576bcdd4b0fbf5008c3a3
    let got1 = commitment(
        table: 0x9999,
        game_id: 7,
        round: 3,
        seat: Seat::s2(),
        colour: Colour::Blue,
        nonce: 0x424242,
    )
    assert!(got1 == exp1)
    "  [OK] COMMIT_VEC_1 = ".fmt(mut buf)
    push_hex_u256(mut buf, got1)
    "\n".fmt(mut buf)

    let exp_d1: u256 = 0x1408f305575d8ccfef6aa8d564ac37c4fbc7087ffd7efb9c4cb016fff2d6b657
    let st0 = GameState::new(1001)
    let got_d1 = match step(
        st0,
        0,
        Input::Join,
        StepCtx { now: 1000, caller: 0xA1, table: 0x1234, stake_paid: 1001 },
    ) {
        Result::Ok(o) => o.digest,
        Result::Err(_) => 0,
    }
    assert!(got_d1 == exp_d1)
    "  [OK] DIGEST_JOIN_1 = ".fmt(mut buf)
    push_hex_u256(mut buf, got_d1)
    "\n".fmt(mut buf)

    let batch1 = rolling_parity_range(1, 100, 1001, 0xCAFE)
    "  [OK] PARITY_BATCH_1_100 = ".fmt(mut buf)
    push_hex_u256(mut buf, batch1)
    "\nALL EMBEDDED CAST VECTORS VERIFIED.\n".fmt(mut buf)
    print_buffer(buf)
}

fn parse_arg_u256(_ arg_str: std::env::Arg) -> Option<u256> {
    var tmp = MemBuffer::empty()
    arg_str.fmt(mut tmp)
    parse_u256_slice(ref tmp, 0, tmp.len())
}

fn cmd_play() uses (args: Args, out: mut Stdout, fs: mut Fs, proc: Exit) {
    let argc = args.count()
    var seed: u256 = 1
    var mode: u8 = 0
    var stake: u256 = 1001
    var out_idx: usize = 0
    var show_steps = false

    var i: usize = 2
    while i < argc {
        let a = args.get(i)
        if a == "--seed" && (i + 1) < argc {
            match parse_arg_u256(args.get(i + 1)) {
                Option::Some(v) => {
                    seed = v
                },
                Option::None => {},
            }
            i = i + 2
        } else if a == "--stake" && (i + 1) < argc {
            match parse_arg_u256(args.get(i + 1)) {
                Option::Some(v) => {
                    stake = v
                },
                Option::None => {},
            }
            i = i + 2
        } else if a == "--strategy" && (i + 1) < argc {
            let s_arg = args.get(i + 1)
            if s_arg == "forfeit" {
                mode = 1
            } else if s_arg == "biased" {
                mode = 2
            } else if s_arg == "exploiter" {
                mode = 3
            } else {
                mode = 0
            }
            i = i + 2
        } else if a == "--out" && (i + 1) < argc {
            out_idx = i + 1
            i = i + 2
        } else if a == "--steps" {
            show_steps = true
            i = i + 1
        } else {
            i = i + 1
        }
    }

    var trace_buf = MemBuffer::empty()
    var log_buf = MemBuffer::empty()
    let _ = play_and_log_with_opts(
        seed,
        mode,
        stake,
        0xCAFE,
        show_steps,
        mut trace_buf,
        mut log_buf,
    )
    print_buffer(trace_buf)

    if out_idx > 0 {
        match fs.write(args.get(out_idx), log_buf.span()) {
            Result::Ok(_) => {},
            Result::Err(_) => {
                proc.exit(1)
            },
        }
    } else {
        print_buffer(log_buf)
    }
}

fn cmd_replay()
uses (args: Args, out: mut Stdout, err: mut Stderr, fs: Fs, proc: Exit)
{
    if args.count() < 3 {
        var ebuf = MemBuffer::empty()
        "Usage: outlier_cli replay <logfile>\n".fmt(mut ebuf)
        eprint_buffer(ebuf)
        proc.exit(1)
    }

    let raw = match fs.read(args.get(2)) {
        Result::Ok(b) => b,
        Result::Err(_) => {
            var ebuf = MemBuffer::empty()
            "ERROR: could not read log file\n".fmt(mut ebuf)
            eprint_buffer(ebuf)
            proc.exit(1)
        },
    }

    var report = MemBuffer::empty()
    let ok = verify_log_buffer(ref raw, mut report)
    if ok {
        print_buffer(report)
    } else {
        print_buffer(report)
        proc.exit(1)
    }
}

fn cmd_analyze() uses (out: mut Stdout) {
    var buf = MemBuffer::empty()
    run_analysis_report(mut buf)
    print_buffer(buf)
}

pub fn main() uses (host: mut Host) {
    with (Args = host, Stdout = host, Stderr = host, Fs = host, Exit = host) {
        run_cli()
    }
}

fn run_cli()
uses (args: Args, out: mut Stdout, err: mut Stderr, fs: mut Fs, proc: Exit)
{
    if args.count() < 2 {
        cmd_explain()
        return
    }
    let sub = args.get(1)
    if sub == "explain" {
        cmd_explain()
    } else if sub == "vectors" {
        cmd_vectors()
    } else if sub == "play" {
        cmd_play()
    } else if sub == "replay" {
        cmd_replay()
    } else if sub == "analyze" {
        cmd_analyze()
    } else {
        cmd_explain()
    }
}
