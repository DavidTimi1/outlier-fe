// Native Fe Best-Response Value-Iteration Solver & Strategic Agent Simulator (Stage S5 — T5.1–T5.4).
//
// Implemented 100% in Fe (`ingots/outlier_cli/src/solver.fe`) using fixed-point integer arithmetic
// (`SCALE = 1_000_000`, where `1_000_000 = 100.00%` equity) over the shared `outlier_core` rules.

use core::MemBuffer
use ingot::hex::{push_dec, push_pct}
use ingot::log_v1::play_and_log
use outlier_core::{Colour, FINISH, Outcome, ROUND_CAP, Seat, leader, Positions, Position, resolve}
use std::io::Display

const SCALE: u256 = 1_000_000

fn pos_idx(_ r: u8, _ p0: u8, _ p1: u8, _ p2: u8) -> usize {
    // r in 0..=20 (21), p0, p1, p2 in 0..=4 (5 each) -> 21 * 125 = 2625 entries
    ((r as usize) * 125) + ((p0 as usize) * 25) + ((p1 as usize) * 5) + (p2 as usize)
}

fn terminal_cap_equity_s0(_ p0: u8, _ p1: u8, _ p2: u8) -> u256 {
    if p0 > p1 && p0 > p2 {
        SCALE
    } else if p1 > p0 && p1 > p2 {
        0
    } else if p2 > p0 && p2 > p1 {
        0
    } else {
        // Tied maximum at ROUND_CAP refunds each player's stake (1/3 pot share = 33.33%)
        SCALE / 3
    }
}

fn eval_after_move(
    _ table_v: ref [u256; 2625],
    _ r: u8,
    _ winner: u8,
    _ np0: u8,
    _ np1: u8,
    _ np2: u8,
) -> u256 {
    let w_pos = if winner == 0 {
        np0
    } else if winner == 1 { np1 } else { np2 }
    if w_pos >= FINISH {
        return if winner == 0 { SCALE } else { 0 }
    }
    if r >= ROUND_CAP {
        return terminal_cap_equity_s0(np0, np1, np2)
    }
    table_v[pos_idx(r + 1, np0, np1, np2)]
}

fn clamp_adv(_ p: u8) -> u8 {
    if p >= FINISH { FINISH } else { p + 1 }
}

fn clamp_push(_ p: u8) -> u8 {
    if p == 0 { 0 } else { p - 1 }
}

/// Opponent policy for S1 and S2 used in best-response MDP:
/// - Advance if advancing reaches `FINISH`
/// - Else if the strict leader is at `FINISH - 1`, push that leader
/// - Else Advance
fn opponent_move_value(
    _ table_v: ref [u256; 2625],
    _ r: u8,
    _ winner: u8,
    _ p0: u8,
    _ p1: u8,
    _ p2: u8,
) -> u256 {
    if winner == 1 {
        if p1 + 1 >= FINISH {
            return 0
        }
        if p0 >= (FINISH - 1) && p0 >= p2 {
            return eval_after_move(table_v, r, 1, clamp_push(p0), p1, p2)
        }
        if p2 >= (FINISH - 1) && p2 > p0 {
            return eval_after_move(table_v, r, 1, p0, p1, clamp_push(p2))
        }
        eval_after_move(table_v, r, 1, p0, clamp_adv(p1), p2)
    } else {
        if p2 + 1 >= FINISH {
            return 0
        }
        if p0 >= (FINISH - 1) && p0 >= p1 {
            return eval_after_move(table_v, r, 2, clamp_push(p0), p1, p2)
        }
        if p1 >= (FINISH - 1) && p1 > p0 {
            return eval_after_move(table_v, r, 2, p0, clamp_push(p1), p2)
        }
        eval_after_move(table_v, r, 2, p0, p1, clamp_adv(p2))
    }
}

/// Runs the full native Fe analytical report (`outlier_cli analyze`) and appends to `out`.
pub fn run_analysis_report(_ out: mut MemBuffer) {
    "========================================================================\n".fmt(mut out)
    "OUTLIER — Native Fe Strategic & Game-Theoretic Analysis (Stage S5)\n".fmt(mut out)
    "========================================================================\n\n".fmt(mut out)

    // ------------------------------------------------------------------------
    // 1. Exhaustive Stage-Game Theorem (P0)
    // ------------------------------------------------------------------------
    "1. STAGE-GAME UNIFORM INDIFFERENCE THEOREM (P0 — Exhaustive 27 Triples)\n".fmt(mut out)
    "------------------------------------------------------------------------\n".fmt(mut out)
    var w_combos: u256 = 0
    var nw_combos: u256 = 0
    var s0_by_col: [u256; 3] = [0, 0, 0]
    var a: u8 = 0
    while a < 3 {
        var b: u8 = 0
        while b < 3 {
            var c: u8 = 0
            while c < 3 {
                let ca = match Colour::from_u8(a) {
                    Option::Some(v) => v,
                    Option::None => Colour::Red,
                }
                let cb = match Colour::from_u8(b) {
                    Option::Some(v) => v,
                    Option::None => Colour::Red,
                }
                let cc = match Colour::from_u8(c) {
                    Option::Some(v) => v,
                    Option::None => Colour::Red,
                }
                match resolve(ca, cb, cc) {
                    Outcome::NoWinner => {
                        nw_combos = nw_combos + 1
                    },
                    Outcome::Winner { seat } => {
                        w_combos = w_combos + 1
                        if seat.raw == 0 {
                            s0_by_col[a as usize] = s0_by_col[a as usize] + 1
                        }
                    },
                }
                c = c + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    "  Total colour triples (3^3) : 27\n".fmt(mut out)
    "  Winner combinations        : ".fmt(mut out)
    push_dec(mut out, w_combos)
    " (6 per seat = 2/9 = 22.22% each)\n".fmt(mut out)
    "  No-winner combinations     : ".fmt(mut out)
    push_dec(mut out, nw_combos)
    " (3 all-same + 6 all-distinct = 1/3 = 33.33%)\n".fmt(mut out)
    "  S0 wins by own colour      : Red=".fmt(mut out)
    push_dec(mut out, s0_by_col[0])
    "/9, Blue=".fmt(mut out)
    push_dec(mut out, s0_by_col[1])
    "/9, Green=".fmt(mut out)
    push_dec(mut out, s0_by_col[2])
    "/9\n".fmt(mut out)
    "  => Conclusion: Against uniform opponents, all 3 colours yield identical 2/9 win probability.\n\n"
        .fmt(mut out)

    // ------------------------------------------------------------------------
    // 2. Native Fe Backward-Induction Best-Response Value Iteration (2,500 states)
    // ------------------------------------------------------------------------
    "2. BEST-RESPONSE VALUE ITERATION & ADVANCE-VS-PUSH DECISION BOUNDARY\n".fmt(mut out)
    "------------------------------------------------------------------------\n".fmt(mut out)
    "  Parameters: FINISH=4, PUSH=1, ROUND_CAP=20 (2,500 positional-round states)\n".fmt(mut out)

    var v_table: [u256; 2625] = [0; 2625]

    // Backward induction from r = ROUND_CAP (20) down to r = 1
    var r_rev: u8 = ROUND_CAP
    while r_rev >= 1 {
        var p0: u8 = 0
        while p0 < FINISH {
            var p1: u8 = 0
            while p1 < FINISH {
                var p2: u8 = 0
                while p2 < FINISH {
                    // 1) If S0 wins the round (prob 2/9): S0 chooses max(ADV, PUSH(S1), PUSH(S2))
                    let v_adv = eval_after_move(ref v_table, r_rev, 0, clamp_adv(p0), p1, p2)
                    let v_push1 = eval_after_move(ref v_table, r_rev, 0, p0, clamp_push(p1), p2)
                    let v_push2 = eval_after_move(ref v_table, r_rev, 0, p0, p1, clamp_push(p2))

                    var best_s0 = v_adv
                    if v_push1 > best_s0 {
                        best_s0 = v_push1
                    }
                    if v_push2 > best_s0 {
                        best_s0 = v_push2
                    }

                    // 2) If S1 wins the round (prob 2/9)
                    let v_s1 = opponent_move_value(ref v_table, r_rev, 1, p0, p1, p2)

                    // 3) If S2 wins the round (prob 2/9)
                    let v_s2 = opponent_move_value(ref v_table, r_rev, 2, p0, p1, p2)

                    // 4) If NoWinner (prob 3/9)
                    let v_nw = if r_rev >= ROUND_CAP {
                        terminal_cap_equity_s0(p0, p1, p2)
                    } else {
                        v_table[pos_idx(r_rev + 1, p0, p1, p2)]
                    }

                    // Expected equity = (2*best_s0 + 2*v_s1 + 2*v_s2 + 3*v_nw) / 9
                    let expected_v = ((best_s0 * 2) + (v_s1 * 2) + (v_s2 * 2) + (v_nw * 3)) / 9
                    v_table[pos_idx(r_rev, p0, p1, p2)] = expected_v

                    p2 = p2 + 1
                }
                p1 = p1 + 1
            }
            p0 = p0 + 1
        }
        r_rev = r_rev - 1
    }

    let v_init = v_table[pos_idx(1, 0, 0, 0)]
    "  Exact DP initial equity V(round=1, pos=(0,0,0)) for S0 : ".fmt(mut out)
    push_pct(mut out, v_init)
    "\n\n  Canonical Advance-vs-Push Decision Table (Round 5, S0 wins round):\n".fmt(mut out)
    "  State (p0,p1,p2) | Equity(ADV) | Equity(PUSH S1) | Equity(PUSH S2) | Best Action\n"
        .fmt(mut out)
    "  -----------------+-------------+-----------------+-----------------+------------\n"
        .fmt(mut out)

    // Print 8 representative strategic board states at Round 5
    let sample_p0: [u8; 8] = [0, 2, 3, 0, 1, 2, 1, 2]
    let sample_p1: [u8; 8] = [0, 2, 3, 3, 3, 3, 2, 1]
    let sample_p2: [u8; 8] = [0, 2, 3, 0, 1, 0, 2, 3]
    var si: usize = 0
    while si < 8 {
        let a0 = sample_p0[si]
        let a1 = sample_p1[si]
        let a2 = sample_p2[si]
        let va = eval_after_move(ref v_table, 5, 0, clamp_adv(a0), a1, a2)
        let vp1 = eval_after_move(ref v_table, 5, 0, a0, clamp_push(a1), a2)
        let vp2 = eval_after_move(ref v_table, 5, 0, a0, a1, clamp_push(a2))

        "      (".fmt(mut out)
        push_dec(mut out, a0 as u256)
        ",".fmt(mut out)
        push_dec(mut out, a1 as u256)
        ",".fmt(mut out)
        push_dec(mut out, a2 as u256)
        ")        |   ".fmt(mut out)
        push_pct(mut out, va)
        "   |     ".fmt(mut out)
        push_pct(mut out, vp1)
        "     |     ".fmt(mut out)
        push_pct(mut out, vp2)
        "     | ".fmt(mut out)

        if va >= vp1 && va >= vp2 {
            "ADVANCE\n".fmt(mut out)
        } else if vp1 >= vp2 {
            "PUSH(S1)  <-- defensive block!\n".fmt(mut out)
        } else {
            "PUSH(S2)  <-- defensive block!\n".fmt(mut out)
        }
        si = si + 1
    }

    // ------------------------------------------------------------------------
    // 3. Empirical Monte-Carlo & Adaptive Exploiter vs Biased Opponent (T5.3)
    // ------------------------------------------------------------------------
    "\n3. EMPIRICAL SIMULATIONS THROUGH `outlier_core::step` (300 games/regime)\n".fmt(mut out)
    "------------------------------------------------------------------------\n".fmt(mut out)

    let regimes: [u8; 3] = [0, 2, 3] // 0=Uniform, 2=Uniform vs Biased S1, 3=Exploiter vs Biased S1
    for mode in regimes {
        var s0_wins: u256 = 0
        var s1_wins: u256 = 0
        var s2_wins: u256 = 0
        var draws: u256 = 0
        var total_steps: u256 = 0
        var seed: u256 = 1
        while seed <= 300 {
            var dummy_trace = MemBuffer::empty()
            var dummy_log = MemBuffer::empty()
            let res = play_and_log(seed, mode, 1001, 0xCAFE, mut dummy_trace, mut dummy_log)
            total_steps = total_steps + res.state.step_no
            if res.payouts[0] == 3003 {
                s0_wins = s0_wins + 1
            } else if res.payouts[1] == 3003 {
                s1_wins = s1_wins + 1
            } else if res.payouts[2] == 3003 {
                s2_wins = s2_wins + 1
            } else {
                draws = draws + 1
            }
            seed = seed + 1
        }

        if mode == 0 {
            "  Regime A (Uniform vs Uniform vs Uniform):\n".fmt(mut out)
        } else if mode == 2 {
            "  Regime B (Uniform S0 vs Biased-Red-70% S1 vs Uniform S2):\n".fmt(mut out)
        } else {
            "  Regime C (Adaptive-Exploiter S0 vs Biased-Red-70% S1 vs Uniform S2):\n".fmt(mut out)
        }
        "    S0 wins=".fmt(mut out)
        push_dec(mut out, s0_wins)
        "/300 (".fmt(mut out)
        push_pct(mut out, (s0_wins * SCALE) / 300)
        ") | S1 wins=".fmt(mut out)
        push_dec(mut out, s1_wins)
        "/300 | S2 wins=".fmt(mut out)
        push_dec(mut out, s2_wins)
        "/300 | Draws=".fmt(mut out)
        push_dec(mut out, draws)
        " | Avg transitions=".fmt(mut out)
        push_dec(mut out, total_steps / 300)
        "\n".fmt(mut out)
    }

    "\n4. ABORT-RESISTANCE & ANTI-KINGMAKING GUARANTEES (P1-P5, P13)\n".fmt(mut out)
    "------------------------------------------------------------------------\n".fmt(mut out)
    "  - P1/P2/P3/P4: Unilateral forfeit net = -STAKE <= worst honest net (-STAKE).\n".fmt(mut out)
    "  - P5 (Type-Level): `settle_forfeit(mask, stake)` cannot depend on board positions.\n"
        .fmt(mut out)
    "  - P13: No coalition causing all forfeits in a game achieves positive net profit.\n"
        .fmt(mut out)
}
