        f_out.payouts[0] == 0 && f_out.payouts[1] == 1502 && f_out.payouts[2] == 1501,
    )
    // Oracle Commit-phase Forfeit(mask=2) -> [1502, 0, 1501]
    var c_step = join_three(stake, table)
