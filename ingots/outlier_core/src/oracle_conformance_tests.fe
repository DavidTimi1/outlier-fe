#[test]
fn test_oracle_conformance_multi_round_win_timeout_move_and_cap() {
    let stake: u256 = 1001
    let table: u256 = 0xBEEF
    var cur = join_three(stake, table)
    var ts: u256 = 200

    // Round 1: S0 wins (Blue=1 vs Red=0, Red=0), pushes S1 at 0 (saturates at 0)
    cur = play_round(cur, table, ts, 1, 0, 0)
    cur = unwrap_ok(
        step(
            cur.state,
            cur.digest,
            Input::MoveInput { mv: Move::Push { target: Seat::s1() } },
            StepCtx { now: ts + 2, caller: 0x10, table, stake_paid: 0 },
        ),
    )
    assert!(
        cur.state.positions.p0.to_u8() == 0 && cur.state.positions.p1.to_u8() == 0,
    )
    ts = ts + 10

    // Rounds 2..=5: S0 wins 4 times; on Round 5 S0 times out in WinnerMove -> Poke defaults to Advance -> S0 reaches FINISH(4) and wins!
    var r: u8 = 0
    while r < 3 {
        cur = play_round(cur, table, ts, 2, 0, 0)
        cur = unwrap_ok(
            step(
                cur.state,
                cur.digest,
                Input::MoveInput { mv: Move::Advance },
                StepCtx { now: ts + 2, caller: 0x10, table, stake_paid: 0 },
            ),
        )
        ts = ts + 10
        r = r + 1
    }
    assert!(cur.state.positions.p0.to_u8() == FINISH - 1)
    cur = play_round(cur, table, ts, 2, 0, 0)
    // Timeout Poke on WinnerMove applies default Advance -> S0 reaches FINISH!
    cur = unwrap_ok(
        step(
            cur.state,
            cur.digest,
            Input::Poke,
            StepCtx { now: ts + 1 + MOVE_WINDOW + 1, caller: 0x99, table, stake_paid: 0 },
        ),
    )
    assert!(cur.finished)
    assert!(
        cur.payouts[0] == 3003 && cur.payouts[1] == 0 && cur.payouts[2] == 0,
    )

    // Game #2: 20 NoWinner rounds (all-distinct 0,1,2) reach ROUND_CAP with tied 0,0,0 -> CapReached(None) refund
    cur = join_three(stake, table)
    ts = 200
    var rnd: u8 = 1
    while rnd <= ROUND_CAP {
        cur = play_round(cur, table, ts, 0, 1, 2)
        ts = ts + 10
        rnd = rnd + 1
    }
    assert!(cur.finished)
    assert!(
        cur.payouts[0] == 1001 && cur.payouts[1] == 1001 && cur.payouts[2] == 1001,
    )

    // Game #3: 19 NoWinner rounds, then Round 20 (ROUND_CAP) S1 wins and advances to 1 (< FINISH) -> CapReached(Some(S1))
    cur = join_three(stake, table)
    ts = 200
    var rnd3: u8 = 1
    while rnd3 < ROUND_CAP {
        cur = play_round(cur, table, ts, 0, 0, 0)
        ts = ts + 10
        rnd3 = rnd3 + 1
    }
    cur = play_round(cur, table, ts, 0, 1, 0)
    cur = unwrap_ok(
        step(
            cur.state,
            cur.digest,
            Input::MoveInput { mv: Move::Advance },
            StepCtx { now: ts + 2, caller: 0x20, table, stake_paid: 0 },
        ),
    )
    assert!(cur.finished)
    assert!(
        cur.payouts[0] == 0 && cur.payouts[1] == 3003 && cur.payouts[2] == 0,
    )
}
