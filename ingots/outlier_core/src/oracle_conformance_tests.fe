        ),
    )
    assert!(f_out.finished)
    assert!(
        f_out.payouts[0] == 1502 && f_out.payouts[1] == 0 && f_out.payouts[2] == 1501,
    )
    // Oracle Commit-phase Forfeit(mask=3) -> [0, 0, 3003]
