use ingot::{
    COMMIT_WINDOW,
    Colour,
    FINISH,
    GameResult,
    GameState,
    Input,
    JOIN_WINDOW,
    MOVE_WINDOW,
    Move,
    Phase,
    REVEAL_WINDOW,
    ROUND_CAP,
    Seat,
    StepCtx,
    StepError,
    StepOut,
    commitment,
    settle,
    step,
}

fn unwrap_ok(_ res: Result<StepError, StepOut>) -> StepOut {
    match res {
        Result::Ok(o) => o,
        Result::Err(_) => {
            assert!(false)
            StepOut {
                state: GameState::new(0),
                input_event: ingot::InputEvent::Poked { caller: 0 },
                digest: 0,
                finished: false,
                payouts: [0, 0, 0],
            }
        },
    }
}

fn join_three(_ stake: u256, _ table: u256) -> StepOut {
    let s0 = GameState::new(stake)
    let o1 = unwrap_ok(
        step(
            s0,
            0,
            Input::Join,
            StepCtx { now: 100, caller: 0x10, table, stake_paid: stake },
        ),
    )
    let o2 = unwrap_ok(
        step(
            o1.state,
            o1.digest,
            Input::Join,
            StepCtx { now: 110, caller: 0x20, table, stake_paid: stake },
        ),
    )
    unwrap_ok(
        step(
            o2.state,
            o2.digest,
            Input::Join,
            StepCtx { now: 120, caller: 0x30, table, stake_paid: stake },
        ),
    )
}

fn play_round(_ cur: StepOut, _ table: u256, _ ts: u256, _ c0: u8, _ c1: u8, _ c2: u8) -> StepOut {
    let rnd = cur.state.round as u256
    let gid = cur.state.game_id
    let col0 = match Colour::from_u8(c0) {
        Option::Some(c) => c,
        Option::None => Colour::Red,
    }
    let col1 = match Colour::from_u8(c1) {
        Option::Some(c) => c,
        Option::None => Colour::Red,
    }
    let col2 = match Colour::from_u8(c2) {
        Option::Some(c) => c,
        Option::None => Colour::Red,
    }
    let h0 = commitment(
        table,
        game_id: gid,
        round: rnd,
        seat: Seat::s0(),
        colour: col0,
        nonce: rnd * 10 + 1,
    )
    let h1 = commitment(
        table,
        game_id: gid,
        round: rnd,
        seat: Seat::s1(),
        colour: col1,
        nonce: rnd * 10 + 2,
    )
    let h2 = commitment(
        table,
        game_id: gid,
        round: rnd,
        seat: Seat::s2(),
        colour: col2,
        nonce: rnd * 10 + 3,
    )
    let k0 = unwrap_ok(
        step(
            cur.state,
            cur.digest,
            Input::Commit { hash: h0 },
            StepCtx { now: ts, caller: 0x10, table, stake_paid: 0 },
        ),
    )
    let k1 = unwrap_ok(
        step(
            k0.state,
            k0.digest,
            Input::Commit { hash: h1 },
            StepCtx { now: ts, caller: 0x20, table, stake_paid: 0 },
        ),
    )
    let k2 = unwrap_ok(
        step(
            k1.state,
            k1.digest,
            Input::Commit { hash: h2 },
            StepCtx { now: ts, caller: 0x30, table, stake_paid: 0 },
        ),
    )
    let r0 = unwrap_ok(
        step(
            k2.state,
            k2.digest,
            Input::Reveal { colour_raw: c0, nonce: rnd * 10 + 1 },
            StepCtx { now: ts + 1, caller: 0x10, table, stake_paid: 0 },
        ),
    )
    let r1 = unwrap_ok(
        step(
            r0.state,
            r0.digest,
            Input::Reveal { colour_raw: c1, nonce: rnd * 10 + 2 },
            StepCtx { now: ts + 1, caller: 0x20, table, stake_paid: 0 },
        ),
    )
    unwrap_ok(
        step(
            r1.state,
            r1.digest,
            Input::Reveal { colour_raw: c2, nonce: rnd * 10 + 3 },
            StepCtx { now: ts + 1, caller: 0x30, table, stake_paid: 0 },
        ),
    )
}

#[test]
fn test_oracle_conformance_forfeits_and_cancels() {
    let stake: u256 = 1001
    let table: u256 = 0xCAFE
    // Oracle Cancel(joined=1) -> [1001, 0, 0]
    let s0 = GameState::new(stake)
    var cur = unwrap_ok(
        step(
            s0,
            0,
            Input::Join,
            StepCtx { now: 100, caller: 0x10, table, stake_paid: stake },
        ),
    )
    let fin = unwrap_ok(
        step(
            cur.state,
            cur.digest,
            Input::Poke,
            StepCtx { now: 100 + JOIN_WINDOW + 1, caller: 0x99, table, stake_paid: 0 },
        ),
    )
    assert!(fin.finished)
    assert!(
        fin.payouts[0] == 1001 && fin.payouts[1] == 0 && fin.payouts[2] == 0,
    )
    // Oracle Cancel(joined=2) -> [1001, 1001, 0]
    let s0 = GameState::new(stake)
    var cur = unwrap_ok(
        step(
            s0,
            0,
            Input::Join,
            StepCtx { now: 100, caller: 0x10, table, stake_paid: stake },
        ),
    )
    cur = unwrap_ok(
        step(
            cur.state,
            cur.digest,
            Input::Join,
            StepCtx { now: 110, caller: 0x20, table, stake_paid: stake },
        ),
    )
    let fin = unwrap_ok(
        step(
            cur.state,
            cur.digest,
            Input::Poke,
            StepCtx { now: 100 + JOIN_WINDOW + 1, caller: 0x99, table, stake_paid: 0 },
        ),
    )
    assert!(fin.finished)
    assert!(
        fin.payouts[0] == 1001 && fin.payouts[1] == 1001 && fin.payouts[2] == 0,
    )
    // Oracle Commit-phase Forfeit(mask=1) -> [0, 1502, 1501]
    var c_step = join_three(stake, table)
    c_step = unwrap_ok(
        step(
            c_step.state,
            c_step.digest,
            Input::Commit { hash: 101 },
            StepCtx { now: 200, caller: 0x20, table, stake_paid: 0 },
        ),
    )
    c_step = unwrap_ok(
        step(
            c_step.state,
            c_step.digest,
            Input::Commit { hash: 102 },
            StepCtx { now: 200, caller: 0x30, table, stake_paid: 0 },
        ),
    )
    let f_out = unwrap_ok(
        step(
            c_step.state,
            c_step.digest,
            Input::Poke,
            StepCtx { now: 120 + COMMIT_WINDOW + 1, caller: 0x99, table, stake_paid: 0 },
        ),
    )
    assert!(f_out.finished)
